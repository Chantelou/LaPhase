# Application Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider Credentials (Server-Side Only)
# Google Gemini API (Primary Provider)
GEMINI_API_KEY=""

# Mistral AI API (Automatic Fallback Provider)
MISTRAL_API_KEY=""

# Self-Hosted MongoDB Community Edition (VPS / Docker)
MONGODB_URI="mongodb://study_user:study_secure_password@localhost:27017/ai-study-assistant?authSource=admin"
MONGO_INITDB_ROOT_USERNAME="admin"
MONGO_INITDB_ROOT_PASSWORD="admin_super_secure_password"
MONGODB_DATABASE="ai-study-assistant"
MONGODB_USER="study_user"
MONGODB_PASSWORD="study_secure_password"

# Authentication & Security
AUTH_SECRET="your-super-secret-jwt-key-minimum-32-chars-long"

